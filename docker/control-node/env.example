# Containerized Ansible Control Node Configuration

# Webhook Configuration
WEBHOOK_SECRET=your-secure-webhook-secret-change-me
LOG_LEVEL=INFO

# SSH Key Path (mount your SSH keys)
# Set this to your local SSH directory that contains keys for target servers
SSH_KEY_PATH=/Users/yourusername/.ssh

# Optional: Custom Docker registry
# DOCKER_REGISTRY=your-registry.com

# Optional: Custom network settings
# DOCKER_NETWORK=ansible-control-network 